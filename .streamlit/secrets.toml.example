# OAuth secrets for st.login / st.user (see app.py + docs/13).
# Copy to .streamlit/secrets.toml and fill in the <...> values.
# secrets.toml is gitignored — never commit it. On Cloud Run it is mounted
# from Secret Manager (secret: streamlit-auth).

[auth]
# Local:      http://localhost:8501/oauth2callback
# Cloud Run:  https://<your-cloud-run-url>/oauth2callback
# Must also be listed under "Authorized redirect URIs" on the OAuth client.
redirect_uri = "http://localhost:8501/oauth2callback"
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "<random-64-hex-chars>"

[auth.google]
client_id = "<your-oauth-client-id>.apps.googleusercontent.com"
client_secret = "<your-oauth-client-secret>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
