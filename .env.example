# Copy to .env and fill in the <...> values:  cp .env.example .env
# .env is gitignored — never commit real keys.

# --- Google Cloud ---
PROJECT_ID=<your-gcp-project-id>
LOCATION=us-central1
REGION=us-central1
GCS_BUCKET_NAME=<your-gcs-bucket-name>

# --- Qdrant Cloud ---
QDRANT_URL=<https://your-cluster-id.region.gcp.cloud.qdrant.io:6333>
QDRANT_API_KEY=<your-qdrant-api-key>
QDRANT_COLLECTION_NAME=hr_policies
QDRANT_NOISY_COLLECTION_NAME=hr_policies_noisy_demo

# --- Jina (embeddings + reranker) ---
JINA_API_KEY=<your-jina-api-key>

# --- LangSmith (optional: tracing + evaluation) ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=hrragwithgcp

# --- Models ---
LLM_MODEL_NAME=gemini-2.5-flash
FALLBACK_MODEL_NAME=openai/gpt-oss-20b
EMBEDDING_MODEL_NAME=jina-embeddings-v2-base-en
RERANKER_MODEL_NAME=jina-reranker-v2-base-multilingual
JUDGE_MODEL_NAME=openai/gpt-oss-120b

GEMINI_API_KEY=<your-gemini-api-key>
# Groq: LLM fallback + evaluation judge
GROQ_API_KEY=<your-groq-api-key>

# --- Guardrails ---
# model_armor (needs the Model Armor template) or gemini_lite (no GCP setup)
GUARDRAIL_PROVIDER=model_armor
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=hr-assistant-guardrail

# --- Access control (comma-separated Google accounts allowed to log in) ---
ALLOWED_EMPLOYEE_EMAILS=<you@example.com,colleague@example.com>
